{
  "realm": "ggi",
  "displayName": "GGI Secure AI Chat",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "passwordPolicy": "length(12) and notUsername(undefined) and notEmail(undefined)",
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Regular API user: own chats and subscriptions"
      },
      {
        "name": "admin",
        "description": "System-wide access and analytics"
      },
      {
        "name": "default-roles-ggi",
        "description": "Roles every new account gets",
        "composite": true,
        "composites": {
          "realm": ["user"]
        },
        "clientRole": false
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-ggi",
    "composite": true,
    "clientRole": false
  },
  "clients": [
    {
      "clientId": "ggi-api",
      "name": "GGI API (resource server / token audience)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "ggi-web",
      "name": "GGI web / mobile client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*", "http://127.0.0.1:8765/callback"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "dpop.bound.access.tokens": "true",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "audience-ggi-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ggi-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm-roles-flat",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "user@example.com",
      "email": "user@example.com",
      "firstName": "Demo",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Demo-User-Pass-2026",
          "temporary": false
        }
      ],
      "realmRoles": ["default-roles-ggi"]
    },
    {
      "username": "admin@example.com",
      "email": "admin@example.com",
      "firstName": "Demo",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Demo-Admin-Pass-2026",
          "temporary": false
        }
      ],
      "realmRoles": ["default-roles-ggi", "admin"]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID:replace-me}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET:replace-me}",
        "defaultScope": "openid email profile",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "github",
      "displayName": "GitHub",
      "providerId": "github",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GITHUB_CLIENT_ID:replace-me}",
        "clientSecret": "${GITHUB_CLIENT_SECRET:replace-me}",
        "syncMode": "IMPORT"
      }
    }
  ]
}
