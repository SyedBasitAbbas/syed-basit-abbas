# Copy to .env for local development (`npm run dev` loads it automatically).
NODE_ENV=development
LOG_LEVEL=info
LOG_FORMAT=pretty
HOST=0.0.0.0
PORT=3000
# External URL clients use; DPoP proofs (htu) are checked against it, never against the Host header.
PUBLIC_BASE_URL=http://localhost:3000
# false | true | <hop count> | comma-separated trusted proxy subnets
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
BODY_LIMIT_BYTES=16384
REQUEST_TIMEOUT_MS=10000

# PostgreSQL (docker compose, or `npm run db:dev` for an embedded server without Docker)
DATABASE_URL=postgres://ggi:ggi@localhost:5432/ggi
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_STATEMENT_TIMEOUT_MS=5000

# External OAuth2 / OpenID Connect provider (Keycloak realm from docker-compose by default).
OIDC_ISSUER=http://localhost:8080/realms/ggi
OIDC_AUDIENCE=ggi-api
# Optional: skip discovery (e.g. when the API reaches the IdP on another hostname).
# OIDC_JWKS_URI=http://keycloak:8080/realms/ggi/protocol/openid-connect/certs
OIDC_ALGORITHMS=RS256,PS256,ES256
# Keycloak: `roles` (flattened by the realm's mapper). Auth0: e.g. https://ggi.example.com/roles
OIDC_ROLES_CLAIM=roles
OIDC_CLOCK_TOLERANCE_SEC=5
OIDC_MAX_TOKEN_LIFETIME_SEC=3600

# DPoP (RFC 9449). true = only accept tokens the IdP bound to a key (cnf.jkt).
# false = compatibility mode for IdPs without DPoP (session bound to the first key used).
DPOP_REQUIRE_BOUND_TOKENS=true
DPOP_PROOF_MAX_AGE_SEC=60
DPOP_ALGORITHMS=ES256,EdDSA,RS256,PS256

# Rate limiting (fixed window). postgres = shared across instances.
RATE_LIMIT_STORE=postgres
RATE_LIMIT_WINDOW_SEC=60
RL_GLOBAL_IP=600
RL_AUTH_IP=20
RL_AUTH_USER=10
RL_CHAT_IP=60
RL_CHAT_USER=20
RL_SUBSCRIPTIONS_IP=60
RL_SUBSCRIPTIONS_USER=30
RL_ADMIN_IP=120
RL_ADMIN_USER=120
RL_SYSTEM_IP=60
RL_SYSTEM_USER=60

# Quota and simulations
FREE_MESSAGES_PER_MONTH=3
MOCK_AI_MIN_LATENCY_MS=300
MOCK_AI_MAX_LATENCY_MS=1200
MOCK_AI_FAILURE_RATE=0
PAYMENT_FAILURE_RATE=0.1
# Background jobs: billing simulation, refunds of abandoned chat reservations, cleanup.
BILLING_ENABLED=true
BILLING_INTERVAL_MS=60000
